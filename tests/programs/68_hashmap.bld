// Test 68: HashMap via runtime builtins
// map_new_i32, map_insert_i32, map_get_i32, map_contains_i32, map_len_i32, map_remove_i32
// Uses the typed i32->i32 map family. Keys and values are i32, and
// map_get_i32(h, key, fallback) returns the fallback on a miss.

fn main() ~ Console {
    let m = map_new_i32();

    // Insert key-value pairs
    map_insert_i32(m, 1, 100);
    map_insert_i32(m, 2, 200);
    map_insert_i32(m, 3, 300);

    // Check length
    println!("len: {}", map_len_i32(m));

    // Get values
    println!("get(1): {}", map_get_i32(m, 1, -1));
    println!("get(2): {}", map_get_i32(m, 2, -1));
    println!("get(3): {}", map_get_i32(m, 3, -1));
    println!("get(99): {}", map_get_i32(m, 99, -1));

    // Contains
    if map_contains_i32(m, 2) {
        println!("contains 2: true");
    } else {
        println!("contains 2: false");
    }

    if map_contains_i32(m, 99) {
        println!("contains 99: true");
    } else {
        println!("contains 99: false");
    }

    // Update existing key
    map_insert_i32(m, 2, 999);
    println!("get(2) after update: {}", map_get_i32(m, 2, -1));

    // Remove
    map_remove_i32(m, 1);
    println!("len after remove: {}", map_len_i32(m));
    println!("get(1) after remove: {}", map_get_i32(m, 1, -1));
}
